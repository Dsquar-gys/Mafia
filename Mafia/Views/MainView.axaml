<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mafia.ViewModels"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mafia.Views.MainView"
             x:DataType="vm:MainViewModel">
    
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    
    <UserControl.Resources>
        <system:Double x:Key="HeaderHeight">60</system:Double>
        <system:TimeSpan x:Key="TransitionDuration">0:00:00.600</system:TimeSpan>
    </UserControl.Resources>
    
    <Grid>
		<Grid.RowDefinitions>
			<!-- Header -->
			<RowDefinition Height="Auto"
			               MinHeight="{StaticResource HeaderHeight}"
			               MaxHeight="{StaticResource HeaderHeight}"/>
			<!-- Body -->
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		
		<!-- Header -->
		<Grid Grid.Row="0"
		      Name="HeaderControl"
		      Opacity="0"
		      Background="{StaticResource DarkBlue}"
		      ColumnDefinitions="Auto, *, Auto">
			
			<Grid.Transitions>
				<Transitions>
					<DoubleTransition Property="Opacity"
					                  Duration="{StaticResource TransitionDuration}"/>
				</Transitions>
			</Grid.Transitions>
			
			<!-- Back/Forward -->
			<Button Grid.Column="0"
			        Classes="System"
			        Command="{CompiledBinding MoveBackCommand}">
				<Image Source="/Assets/arrow-left.png" />
			</Button>
			
			<Button Grid.Column="2"
			        Classes="System"
			        Command="{CompiledBinding MoveNextCommand}">
				<Image Source="/Assets/arrow-right.png" />
			</Button>
			
			<!-- End Session button -->
			<Button Grid.Column="1"
			        Classes="System"
			        HorizontalAlignment="Right"
			        Content="End Session"
			        IsEnabled="{Binding CanEarlyEndSession}"
			        Command="{Binding EarlyEndSessionCommand}"
			        Opacity="{Binding CanEarlyEndSession}">
				<Button.Transitions>
					<Transitions>
						<DoubleTransition Property="Opacity"
						                  Duration="{StaticResource TransitionDuration}" />
					</Transitions>
				</Button.Transitions>
			</Button>
			
			<TransitioningContentControl Grid.Column="1"
			                             Content="{Binding CurrentPage.Header}">
				<TransitioningContentControl.PageTransition>
					<CrossFade Duration="{StaticResource TransitionDuration}" />
				</TransitioningContentControl.PageTransition>
			</TransitioningContentControl>
			
			<Grid.Styles>
				<Style Selector="Button.System">
					<Setter Property="VerticalAlignment" Value="Stretch" />
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="MaxHeight" Value="{StaticResource HeaderHeight}" />
				</Style>
				<Style Selector="Button.System[IsEffectivelyEnabled=False] > Image">
					<Setter Property="Opacity" Value="0.4" />
				</Style>
			</Grid.Styles>
			
		</Grid>
		
		<!-- Content Body -->
		<TransitioningContentControl Grid.Row="1"
		                             Name="CurrentPageControl"
		                             Content="{Binding CurrentPage}">
			<TransitioningContentControl.PageTransition>
				<CrossFade Duration="{StaticResource TransitionDuration}" />
			</TransitioningContentControl.PageTransition>
			<TransitioningContentControl.Transitions>
				<Transitions>
					<BrushTransition Property="Background"
					                 Duration="{StaticResource TransitionDuration}" />
				</Transitions>
			</TransitioningContentControl.Transitions>
		</TransitioningContentControl>
		
	</Grid>
    
</UserControl>
